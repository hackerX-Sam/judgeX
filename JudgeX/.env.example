# =====================================================================
# ⚡ JUDGEX ENVIRONMENT VARIABLES CONFIGURATION SPECIFICATION
# =====================================================================

# ---------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC VARIABLES (Safe for browser / Vercel Frontend)
# ---------------------------------------------------------------------
# Supabase Project URL (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Backend Execution API URL (In production: your backend URL or Vercel API proxy)
VITE_API_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY KEEP PRIVATE ON SERVER / VERCEL SECRETS)
# NEVER EXPOSE THESE KEYS IN CLIENT-SIDE CODE!
# ---------------------------------------------------------------------
# Supabase URL for backend
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key for backend
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Secret Key (Bypasses RLS - ONLY USE ON SERVER FOR HIDDEN TESTCASES)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# JWT Secret Key for token signing
JWT_SECRET="your-complex-jwt-secret-token"

# Database Connection URL (Supabase Transaction Pooler connection string)
DATABASE_URL="postgres://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# OpenAI API Key (For AI Code Intelligence analysis & auto refactoring)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Redis Server URL (For BullMQ Judge Queue)
REDIS_URL="redis://127.0.0.1:6379"

# Express Server Port
PORT=3000
